def handle_request():
    """Handle button click event."""
    user_input = entry.get().strip()
    if not user_input:
        messagebox.showerror("Input Error", "Please enter a diagnostic request.")
        return

    response = canoe.send_diag_request("EMS", user_input)
    print(response)
    if "Positive Response" in response:
        messagebox.showinfo("Response", f"Positive Response: {response}")
    elif "Negative Response" in response:
        messagebox.showwarning("Response", f"Negative Response: {response}")
    else:
        messagebox.showerror("Response Error", f"Unexpected response: {response}")

# GUI setup
root = tk.Tk()
root.title("Diagnostic Request Tool")

# Input label and entry field
label = tk.Label(root, text="Enter Diagnostic Request (e.g., '10 03'):")
