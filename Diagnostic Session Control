testcase Extended_Session()
{ 
  byte NewRequest[2] = {0x10, 0x04};
  DiagGetPrimitiveSize(Extendrequest_Session);
  diagResize(Extendrequest_Session,2);
  diagSetPrimitiveData(Extendrequest_Session,NewRequest,2);
  diagSendRequest(Extendrequest_Session);
  testWaitForDiagRequestSent(Extendrequest_Session,1000);
  testStep("","send the following request");
  testReportWriteDiagObject(Extendrequest_Session);
 // testReportWriteDiagResponse(Extendrequest_Session);
 // testReportWriteDiagObject(ExtendResponse_Session);
  //testStepPass("","Positive Responce Recieved for Extended Session Request");
  if(Diag_Event_Accured == testWaitForDiagResponse(Extendrequest_Session,3000))
  {
    testStep("","Recieved Responce");
    
    //testReportWriteDiagResponse(Extendrequest_Session);
    testWaitForTimeout(1000);
    if(no_Error==diagInterpretRespAs(Extendrequest_Session,"STDS_PR")){
      temp =diagInterpretRespAs(Extendrequest_Session,"STDS_PR");
      testReportWriteDiagObject(ExtendResponse_Session);
      testStepPass("","Positive Responce Recieved for Extended Session Request");     
    }
    else{
      NRC_data=diagGetLastResponseCode(Extendrequest_Session);
      switch(NRC_data)
    {
      case 0x12:
        {
          testStepFail("","sub-functionNotSupported = 0x%02x",NRC_data);
          testStepPass("","This NRC shall be sent if the sub-function parameter is not supported.");   
        }
        break;
        case 0x13:
        {
          testStepFail("","incorrectMessageLengthOrInvalidFormat = 0x%02x",NRC_data);
          testStepPass("","This NRC shall be sent if the length of the message is wrong.");   
        }
        break;
        case 0x22:
        {
          testStepFail("","conditionsNotCorrect = 0x%02x",NRC_data);
          testStepPass("","This NRC shall be returned if the criteria for the request DiagnosticSessionControl are not met.");   
        }
        break;
        }
      testStepFail("","Negative  Responce Recieved for Extended Session Request = 0x%02x",NRC_data);
    }
  }
  
}

